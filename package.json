{
  "name": "engram",
  "version": "0.1.0",
  "description": "Bio-inspired memory layer for Claude Code — episodic encoding, cue-based retrieval, and consolidation",
  "type": "module",
  "main": "dist/core/index.js",
  "bin": {
    "engram": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/mcp/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "consolidate": "tsx src/cli.ts consolidate",
    "status": "tsx src/cli.ts status",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.2",
    "openai": "^6.27.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
